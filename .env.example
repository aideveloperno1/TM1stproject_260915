# 복사해서 .env로 저장하고 값을 채운다. .env는 git에 올라가지 않는다.
# 실행: uv run --env-file .env policy-signal-map

# 분석 근거 파일 (비우면 합성 파일 사용). 실제 파일은 private/ 아래에만 둔다.
PSM_EVIDENCE_PATH=

# LLM (C 단계 전까지 none). 값: none, cloud, local
PSM_LLM_PROVIDER=none
# local일 때: OpenAI 호환 서버 주소
PSM_LLM_BASE_URL=
# cloud, local일 때: 모델 이름
PSM_LLM_MODEL=
# cloud일 때: API 키
PSM_LLM_API_KEY=
